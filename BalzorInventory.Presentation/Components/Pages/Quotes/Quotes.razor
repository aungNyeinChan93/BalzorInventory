@page "/quotes";


<PageTitle>Quotes</PageTitle>

<HeadContent>
    @foreach (var q in MyQuotes)
    {
        <meta name="@q.Title" description="@(q.Description)"  />
    }
</HeadContent>

<section>
    <h3>Quotes</h3>

    @if (MyQuotes is not null)
    {
        <ul>
            @foreach (var quote in MyQuotes)
            {
                <li class="text-danger p-2">@(quote.Title)</li>
            }
        </ul>
    }
    else
    {
        <p>Loading ... </p>
    }


</section>

@code {

    [Inject]
    private IViewAllQuotesUseCase _ViewAllQuotesUseCase { get; set; }

    public List<Quote> MyQuotes { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        var quotes = await _ViewAllQuotesUseCase.ExecuteAsync();
        if (quotes is not null)
        {
            MyQuotes = [.. quotes];
        }
    }
}
