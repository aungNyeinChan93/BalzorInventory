@page "/inventories"
@inject IViewInventoriesUseCase _IViewInventoriesUseCase;

<HeadContent>
    <PageTitle>Inventory Lists</PageTitle>
    @foreach (var inv in MyInventories)
    {
        <meta @key="inv.InventoryId" name="@inv.Name" price="@inv.Price"/>
    }
</HeadContent>

<section>
    <a href="/createInventory">Create Inventory</a>
    @if (MyInventories is null)
    {
        <p>Loading  ...</p>
    }
    else
    {
        <div class="my-4 p-2">
            <SerachInventoryComponent GetSearchKeyEvent="GetSearchKey" />
            <InventoryListComponent Inventories="MyInventories"/>
        </div>
    }   
</section>

@code {
    public List<Inventory> MyInventories { get; set; } = [];

    public async Task GetSearchKey(string? inventoryName = "")
    {
        var inventories = inventoryName is null
            ? await _IViewInventoriesUseCase.ViewAllInventories()
            : await _IViewInventoriesUseCase.ViewAllInventories(inventoryName);

        MyInventories = inventories is not null
            ? [.. inventories]
            : [];

    }

    protected override async Task OnInitializedAsync()
    {
        await GetSearchKey();
    }
}
